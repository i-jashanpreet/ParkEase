PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/parkease?replicaSet=rs0
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-32-byte-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
ADMIN_NAME=ParkEase Admin
ADMIN_EMAIL=admin@parkease
ADMIN_PASSWORD=replace-with-a-strong-password
# MongoDB must be an Atlas deployment or a local replica set for transactions.
ENTRY_GRACE_MINUTES=15
QR_TTL_SECONDS=300
EXPIRY_SWEEP_MS=30000
