+  EXPIRED: "EXPIRED",
+});
+
+export const BILLING_STATUS = Object.freeze({
+  PENDING: "PENDING",
+  GENERATED: "GENERATED",
+  WAIVED: "WAIVED",
+});
+
+export const QR_TOKEN_STATUS = Object.freeze({
+  ACTIVE: "ACTIVE",
+  CONSUMED: "CONSUMED",
+  REVOKED: "REVOKED",
+  EXPIRED: "EXPIRED",
+});
+
+export default Object.freeze({
+  USER_STATUS,
+  MALL_STATUS,
+  SLOT_STATUS,
+  BOOKING_STATUS,
+  BILLING_STATUS,
+  QR_TOKEN_STATUS,
+});
+
