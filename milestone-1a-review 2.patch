--- /dev/null
+++ b/server/src/utils/AppError.js
@@ -0,0 +1,13 @@
+export default class AppError extends Error {
+  constructor(status, message, code = "APP_ERROR", details = undefined) {
+    super(message);
+    this.name = "AppError";
+    this.status =
+      Number.isInteger(status) && status >= 400 && status <= 599 ? status : 500;
+    this.code = code;
+    this.details = details;
+    this.isOperational = true;
+    Error.captureStackTrace?.(this, this.constructor);
+  }
+}
+
diff --git a/server/src/utils/cookies.js b/server/src/utils/cookies.js
new file mode 100644
index 0000000..4807770
--- /dev/null
+++ b/server/src/utils/cookies.js
@@ -0,0 +1,78 @@
+import AppError from "./AppError.js";
+
+export const REFRESH_COOKIE_NAME = "parkease_refresh_token";
+const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;
+
+/**
+ * Returns the HttpOnly refresh cookie options for the current environment.
+ *
+ * Deployment note:
+ * - In local development (http://localhost:5173 -> http://localhost:5000),
+ *   secure is false and sameSite is "lax".
+ * - In production when frontend and backend share the same site/domain,
+ *   secure is true and sameSite is "strict".
+ * - If production frontend and backend are deployed cross-site on separate
+ *   domains, sameSite must be adjusted to "none" (with secure: true) alongside
+ *   strict Origin and custom header CSRF validation.
+ */
+export function getRefreshCookieOptions() {
+  const isProduction = process.env.NODE_ENV === "production";
+  return {
+    httpOnly: true,
+    secure: isProduction,
+    sameSite: isProduction ? "strict" : "lax",
+    path: "/api/auth",
+    maxAge: SEVEN_DAYS_MS,
+  };
+}
+
+export function setRefreshCookie(res, rawToken) {
+  if (!res || typeof res.cookie !== "function") {
+    throw new AppError(500, "Invalid HTTP response object", "INTERNAL_ERROR");
+  }
+  if (typeof rawToken !== "string" || rawToken.trim().length === 0) {
+    throw new AppError(
+      400,
+      "Refresh token must be a non-empty string",
+      "INVALID_TOKEN_INPUT",
+    );
+  }
+  res.cookie(REFRESH_COOKIE_NAME, rawToken, getRefreshCookieOptions());
+}
+
+export function clearRefreshCookie(res) {
+  if (!res || typeof res.clearCookie !== "function") {
+    throw new AppError(500, "Invalid HTTP response object", "INTERNAL_ERROR");
+  }
+  const { httpOnly, secure, sameSite, path } = getRefreshCookieOptions();
+  res.clearCookie(REFRESH_COOKIE_NAME, {
+    httpOnly,
+    secure,
+    sameSite,
+    path,
+  });
+}
+
+export function parseCookies(req) {
+  const header = req?.headers?.cookie;
+  if (typeof header !== "string" || header.trim().length === 0) {
+    return {};
+  }
+
+  const cookies = {};
+  const pairs = header.split(";");
+  for (const pair of pairs) {
+    const separatorIndex = pair.indexOf("=");
+    if (separatorIndex <= 0) continue;
+    const key = pair.slice(0, separatorIndex).trim();
+    const rawValue = pair.slice(separatorIndex + 1).trim();
+    if (!key) continue;
+    try {
+      cookies[key] = decodeURIComponent(rawValue);
+    } catch {
+      cookies[key] = rawValue;
+    }
+  }
+  return cookies;
+}
+
diff --git a/server/src/utils/jwt.js b/server/src/utils/jwt.js
new file mode 100644
index 0000000..ba0d6e9
--- /dev/null
+++ b/server/src/utils/jwt.js
@@ -0,0 +1,127 @@
+import crypto from "node:crypto";
+import jwt from "jsonwebtoken";
+import ROLES from "../constants/roles.js";
+import { USER_STATUS } from "../constants/statuses.js";
+import AppError from "./AppError.js";
+
+const DEFAULT_ACCESS_EXPIRES_IN = "15m";
+const PLACEHOLDER_SECRET = "replace-with-a-strong-random-secret";
+const REFRESH_TOKEN_BYTES = 32;
+
+function getAccessSecret() {
+  const secret = process.env.JWT_ACCESS_SECRET;
+  if (
+    typeof secret !== "string" ||
+    secret.trim().length < 16 ||
+    secret.trim() === PLACEHOLDER_SECRET
+  ) {
+    throw new AppError(
+      500,
+      "JWT_ACCESS_SECRET is missing or invalid",
+      "CONFIG_ERROR",
+    );
+  }
+  return secret;
+}
+
+export function signAccessToken(user) {
+  const secret = getAccessSecret();
+  if (!user || typeof user !== "object") {
+    throw new AppError(
+      400,
+      "User object is required to sign access token",
+      "INVALID_TOKEN_PAYLOAD",
+    );
+  }
+
+  const userId = user._id ?? user.id;
+  if (!userId || String(userId).trim().length === 0) {
+    throw new AppError(
+      400,
+      "User id is required to sign access token",
+      "INVALID_TOKEN_PAYLOAD",
+    );
+  }
+
+  if (!Object.values(ROLES).includes(user.role)) {
+    throw new AppError(
+      400,
+      "Valid user role is required to sign access token",
+      "INVALID_TOKEN_PAYLOAD",
+    );
+  }
+
+  if (!Object.values(USER_STATUS).includes(user.status)) {
+    throw new AppError(
+      400,
+      "Valid user status is required to sign access token",
+      "INVALID_TOKEN_PAYLOAD",
+    );
+  }
+
+  const expiresIn =
+    process.env.JWT_ACCESS_EXPIRES_IN?.trim() || DEFAULT_ACCESS_EXPIRES_IN;
+
+  return jwt.sign(
+    {
+      role: user.role,
+      status: user.status,
+    },
+    secret,
+    {
+      algorithm: "HS256",
+      subject: String(userId),
+      expiresIn,
+    },
+  );
+}
+
+export function verifyAccessToken(token) {
+  const secret = getAccessSecret();
+  if (typeof token !== "string" || token.trim().length === 0) {
+    throw new AppError(401, "Access token is required", "TOKEN_MISSING");
+  }
+
+  try {
+    const decoded = jwt.verify(token, secret, { algorithms: ["HS256"] });
+    if (
+      !decoded ||
+      typeof decoded !== "object" ||
+      typeof decoded.sub !== "string" ||
+      !decoded.sub.trim() ||
+      !Object.values(ROLES).includes(decoded.role) ||
+      !Object.values(USER_STATUS).includes(decoded.status)
+    ) {
+      throw new AppError(
+        401,
+        "Invalid access token payload",
+        "INVALID_TOKEN",
+      );
+    }
+    return decoded;
+  } catch (err) {
+    if (err instanceof AppError) {
+      throw err;
+    }
+    if (err?.name === "TokenExpiredError") {
+      throw new AppError(401, "Access token has expired", "TOKEN_EXPIRED");
+    }
+    throw new AppError(401, "Invalid access token", "INVALID_TOKEN");
+  }
+}
+
+export function generateRefreshToken() {
+  return crypto.randomBytes(REFRESH_TOKEN_BYTES).toString("hex");
+}
+
+export function hashToken(rawToken) {
+  if (typeof rawToken !== "string" || rawToken.trim().length === 0) {
+    throw new AppError(
+      400,
+      "Token must be a non-empty string",
+      "INVALID_TOKEN_INPUT",
+    );
+  }
+  return crypto.createHash("sha256").update(rawToken, "utf8").digest("hex");
+}
+
diff --git a/server/src/utils/password.js b/server/src/utils/password.js
new file mode 100644
index 0000000..faf7b4c
--- /dev/null
+++ b/server/src/utils/password.js
@@ -0,0 +1,60 @@
+import bcrypt from "bcryptjs";
+import AppError from "./AppError.js";
+
+const DEFAULT_SALT_ROUNDS = 10;
+const MAX_BCRYPT_BYTES = 72;
+
+function getSaltRounds() {
+  const raw = process.env.BCRYPT_SALT_ROUNDS;
+  if (raw === undefined || raw === "") {
+    return DEFAULT_SALT_ROUNDS;
+  }
+  const rounds = Number(raw);
+  if (!Number.isInteger(rounds) || rounds < 4 || rounds > 31) {
+    throw new AppError(
+      500,
+      "Invalid BCRYPT_SALT_ROUNDS configuration",
+      "CONFIG_ERROR",
+    );
+  }
+  return rounds;
+}
+
+export async function hashPassword(plainPassword) {
+  if (typeof plainPassword !== "string" || plainPassword.trim().length === 0) {
+    throw new AppError(
+      400,
+      "Password must be a non-empty string",
+      "INVALID_PASSWORD",
+    );
+  }
+  if (Buffer.byteLength(plainPassword, "utf8") > MAX_BCRYPT_BYTES) {
+    throw new AppError(
+      400,
+      "Password must not exceed 72 bytes",
+      "INVALID_PASSWORD",
+    );
+  }
+  const saltRounds = getSaltRounds();
+  return bcrypt.hash(plainPassword, saltRounds);
+}
+
+export async function verifyPassword(plainPassword, passwordHash) {
+  if (
+    typeof plainPassword !== "string" ||
+    plainPassword.length === 0 ||
+    typeof passwordHash !== "string" ||
+    passwordHash.trim().length === 0
+  ) {
+    throw new AppError(
+      400,
+      "Password and passwordHash must be non-empty strings",
+      "INVALID_PASSWORD_INPUT",
+    );
+  }
+  if (Buffer.byteLength(plainPassword, "utf8") > MAX_BCRYPT_BYTES) {
+    return false;
+  }
+  return bcrypt.compare(plainPassword, passwordHash);
+}
+
diff --git a/server/src/utils/validators.js b/server/src/utils/validators.js
new file mode 100644
