+
+export const MALL_STATUS = Object.freeze({
+  PENDING: "PENDING",
+  APPROVED: "APPROVED",
+  REJECTED: "REJECTED",
+  INACTIVE: "INACTIVE",
+});
+
+export const SLOT_STATUS = Object.freeze({
+  AVAILABLE: "AVAILABLE",
+  RESERVED: "RESERVED",
+  OCCUPIED: "OCCUPIED",
+  MAINTENANCE: "MAINTENANCE",
+});
+
+export const BOOKING_STATUS = Object.freeze({
+  CONFIRMED: "CONFIRMED",
